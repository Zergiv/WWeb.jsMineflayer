# WhatsApp: solo este número (sin + ni espacios)
ALLOWED_PHONE=34600000000

# Minecraft 1.20.1 offline
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.20.1
MC_USERNAME=Pruebas

# Transcripción de voz — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.1-flash-lite-preview

# Generación de scripts Mineflayer — https://ollama.com
# OLLAMA_MODEL: elige según tu RAM/GPU (ej. llama3.2:3b en 8GB, llama3.1:8b en 16GB)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_CHAT_TIMEOUT_MS=90000
# Si falla CUDA/GPU, fuerza solo CPU (cierra Ollama, pon esto, vuelve a abrir):
# OLLAMA_NUM_GPU=0

# PM2: npm run pm2:start | pm2:stop | pm2:logs
